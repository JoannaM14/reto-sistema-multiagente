# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.so
*.egg
*.egg-info/
dist/
build/
.eggs/

# ── Entornos virtuales ────────────────────────────────────────────────────────
.venv/
venv/
env/
ENV/
.env

# ── Variables de entorno / secretos ──────────────────────────────────────────
.env
.env.*
*.secret
secrets.toml

# ── Streamlit ─────────────────────────────────────────────────────────────────
.streamlit/secrets.toml

# ── Google ADK / credenciales ─────────────────────────────────────────────────
*.json          # claves de servicio GCP
application_default_credentials.json
gcloud/

# ── Datos (no versionar datasets reales) ─────────────────────────────────────
data/*.csv
data/*.xlsx
data/*.xls
data/*.parquet
# Excepción: mantener el dataset de ejemplo
!data/sample_retail.csv

# ── Jupyter / notebooks ───────────────────────────────────────────────────────
.ipynb_checkpoints/
*.ipynb

# ── IDEs y editores ───────────────────────────────────────────────────────────
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# ── Sistema operativo ─────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── Logs y temporales ─────────────────────────────────────────────────────────
*.log
*.tmp
*.bak
pipeline_log.txt

# ── Modelos entrenados (si se serializa en el futuro) ────────────────────────
models/
*.pkl
*.joblib
*.h5
